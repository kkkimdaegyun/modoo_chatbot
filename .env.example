# Application
APP_NAME=ELA Chatbot
APP_ENV=development
APP_DEBUG=false
FRONTEND_URL=http://localhost:7128
BACKEND_URL=http://localhost:7127
# 브라우저에서 접속하는 모든 주소를 콤마로 나열해야 한다. 여기 없는 주소로 접속하면 CORS에 막힌다.
CORS_ORIGINS=http://localhost:7128,http://192.168.0.41:7128
LOG_LEVEL=INFO
# 비워두면 브라우저가 접속한 호스트에 API 포트를 붙여서 쓴다.
# nginx 뒤에서 같은 도메인의 서브패스로 서비스할 때는 "/leehk" 처럼 경로만 적는다.
# API를 완전히 다른 도메인으로 노출할 때만 https://... 전체 주소를 적는다.
NEXT_PUBLIC_BACKEND_URL=

# 한 도메인 아래에 고객사를 여러 개 올릴 때의 앞자리. 예) /leehk → https://도메인/leehk
# 뿌리(/)로 서비스하면 비워 둔다.
# 주의: 빌드 시점에 번들에 박히는 값이라, 바꾼 뒤에는 ./start.sh 로 이미지를 다시 빌드해야 한다.
BASE_PATH=

# nginx 를 앞에 두면 127.0.0.1 로 두어 컨테이너를 인터넷에 직접 노출하지 않는다.
# 그러면 보안 그룹에서 443/80 만 열어도 되고, 7127/7128 은 열 필요가 없다.
BIND_HOST=0.0.0.0

# 호스트 포트 (이미 점유된 포트면 여기서 바꾸세요)
# 한 서버에 고객사를 여러 벌 올릴 때는 폴더마다 아래 4개를 전부 다르게 준다.
# 이름이 겹치면 나중에 띄운 쪽이 먼저 띄운 고객사의 컨테이너를 내려버린다.
# 예) A: modoo-a / 7128 / 7127 / 5432   B: modoo-b / 7228 / 7227 / 5532
COMPOSE_PROJECT_NAME=book
FRONTEND_PORT=7128
API_PORT=7127
POSTGRES_PORT=5432

# Database
POSTGRES_DB=ela_chatbot
POSTGRES_USER=ela
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ela:change-me@postgres:5432/ela_chatbot

# Admin (로그인 계정은 apps/api/app/core/accounts.py에서 관리)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480

# Gemini Generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.9
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

# Local Embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=auto
EMBEDDING_USE_FP16=true
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=8192
NORMALIZE_EMBEDDINGS=true

# Local Reranker
# CPU에서는 후보 1개당 약 0.85초가 들어 응답이 수십 초로 늘어난다. GPU가 있을 때만 true.
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_USE_FP16=true
RERANKER_MAX_LENGTH=1024
RERANKER_BATCH_SIZE=8

# Chunking
CHUNK_TARGET_TOKENS=750
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=130
CHUNK_MIN_TOKENS=80

# Retrieval
DENSE_RETRIEVAL_TOP_K=30
KEYWORD_RETRIEVAL_TOP_K=30
RRF_K=60
RERANK_CANDIDATES=30
FINAL_CONTEXT_TOP_K=7
SIMILARITY_THRESHOLD=0.25
MAX_CONTEXT_TOKENS=10000
QA_PRIORITY_BOOST=1.15

# Storage
STORAGE_PATH=/app/data/uploads
MAX_UPLOAD_SIZE_MB=50
MODEL_CACHE_PATH=/app/.cache/huggingface
RUN_GEMINI_INTEGRATION_TESTS=false
