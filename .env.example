# Application
APP_NAME=ELA Chatbot
APP_ENV=development
APP_DEBUG=false
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Database
POSTGRES_DB=ela_chatbot
POSTGRES_USER=ela
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ela:change-me@postgres:5432/ela_chatbot

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480

# Gemini Generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.9
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

# Local Embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=auto
EMBEDDING_USE_FP16=true
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=8192
NORMALIZE_EMBEDDINGS=true

# Local Reranker
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_USE_FP16=true
RERANKER_MAX_LENGTH=1024
RERANKER_BATCH_SIZE=8

# Chunking
CHUNK_TARGET_TOKENS=750
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=130
CHUNK_MIN_TOKENS=80

# Retrieval
DENSE_RETRIEVAL_TOP_K=30
KEYWORD_RETRIEVAL_TOP_K=30
RRF_K=60
RERANK_CANDIDATES=30
FINAL_CONTEXT_TOP_K=7
SIMILARITY_THRESHOLD=0.25
MAX_CONTEXT_TOKENS=10000
QA_PRIORITY_BOOST=1.15

# Storage
STORAGE_PATH=/app/data/uploads
MAX_UPLOAD_SIZE_MB=50
MODEL_CACHE_PATH=/app/.cache/huggingface
RUN_GEMINI_INTEGRATION_TESTS=false
