FROM node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# 빌드와 실행을 한 단계에서 처리한다. vinext(0.0.50)는 산출물 위치가 버전마다 달라질 수 있어,
# 결과물만 골라 옮기는 것보다 빌드한 자리에서 그대로 실행하는 쪽이 안전하다.
FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY app ./app
COPY lib ./lib
COPY public ./public
COPY build ./build
COPY worker ./worker
COPY db ./db
# vite.config.ts가 ./.openai/hosting.json을 import 한다.
COPY .openai ./.openai
COPY package.json package-lock.json tsconfig.json vite.config.ts next.config.ts postcss.config.mjs ./
# 프로덕션 빌드. 개발 서버와 달리 요청마다 다시 컴파일하지 않고,
# 오류가 나도 고객 화면에 개발용 오류 오버레이가 뜨지 않는다.
RUN npm run build
EXPOSE 3000
# vinext는 --host가 아니라 --hostname을 받는다. 없으면 localhost에만 바인딩되어 포트 매핑이 닿지 않는다.
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0"]
