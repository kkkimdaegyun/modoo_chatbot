FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=development
COPY --from=deps /app/node_modules ./node_modules
COPY app ./app
COPY lib ./lib
COPY public ./public
COPY build ./build
COPY worker ./worker
COPY db ./db
COPY package.json package-lock.json tsconfig.json vite.config.ts next.config.ts postcss.config.mjs ./
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
